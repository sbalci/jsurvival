msgstr "Gompertz"

#: R/survival.b.R
msgid "Good"
msgstr "İyi"

#: R/survival.b.R
msgid ""
"Gray's test for equality of cumulative incidence of the event of interest "
"across groups: chi-square = {stat}, df = {df}, p = {p}."
msgstr ""
"İlgilenilen olayın kümülatif insidansının gruplar arasında eşitliği için "
"Gray testi: ki-kare = {stat}, sd = {df}, p = {p}."

#: survival/results/ageStandardizationTable.columns.title
#: survival/results/rmstTable.columns.title
#: survivalcont/results/rmstTable.columns.title
