msgstr ""
"'{variable}' açıklayıcı değişkeni {n} düzeye sahip. Kategorileri "
"gruplandırmayı veya sıralı ise sürekli olarak kullanmayı düşünün."

#: R/oddsratio.b.R
msgid ""
"Explanatory variable '{variable}' has no variation (all values are the "
"same). It will not contribute to the model."
msgstr ""
"'{variable}' açıklayıcı değişkeninde varyasyon yok (tüm değerler aynı). "
"Modele katkı sağlamayacaktır."

#: R/oddsratio.b.R
msgid ""
"Explanatory variable '{variable}' is entered as continuous and has {n} "
"value(s) carried by fewer than 5 observations; those rows have high leverage "
"on the fitted trend."
msgstr ""
"'{variable}' açıklayıcı değişkeni sürekli olarak girilmiştir ve 5'ten az "
"gözlem tarafından taşınan {n} değere sahiptir; bu satırlar uyarlanan eğilim "
"üzerinde yüksek kaldıraca (leverage) sahiptir."

#: R/oddsratio.b.R
msgid ""
"Explanatory variable '{variable}' may contain extreme outliers ({n} "
"potential outliers)."
msgstr ""
"'{variable}' açıklayıcı değişkeni aşırı uç değerler içerebilir ({n} olası uç "
"değer)."

#: R/survival.b.R
