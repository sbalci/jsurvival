msgid "Schoenfeld (not case-aligned)"
msgstr "Schoenfeld (olgu hizalı değil)"

#: survivalcont/results/schoenfeldResidualsTable.columns.title
msgid "Schoenfeld Residual"
msgstr "Schoenfeld Kalıntısı"

#: R/survivalcont.b.R
