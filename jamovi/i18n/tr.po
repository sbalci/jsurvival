msgstr "Tanısal Belirteç (OO'lar için)"

#: R/oddsratio.b.R
msgid "Diagnostic predictor label matches multiple variables; using '{variable}'."
msgstr ""
"Tanısal belirteç etiketi birden fazla değişkenle eşleşiyor; '{variable}' "
"kullanılıyor."

#: oddsratio/results/diagnosticMetrics.title
msgid "Diagnostic Test Performance"
msgstr "Tanı Testi Performansı"

#: R/oddsratio.b.R
