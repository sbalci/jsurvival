msgstr ""
"Analiz, ortalama takip süresi {mean} {unit} olan {n} gözlem kullanılarak "
"tamamlandı (toplam kişi-zamanı: {total} kişi-{unit})."

#: R/multisurvival.b.R
msgid ""
"Analysis completed using %d observations with %d events (%.1f%% event rate) "
"over a median follow-up of %.1f %s (reverse Kaplan-Meier)."
msgstr ""
"Analiz %d gözlem ve %d olay (%%%.1f olay oranı) ile, %.1f %s ortanca izlem "
"süresinde (ters Kaplan-Meier) tamamlandı."

#: R/multisurvival.b.R
